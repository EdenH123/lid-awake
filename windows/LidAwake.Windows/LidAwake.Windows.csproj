<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LidAwake</AssemblyName>
    <RootNamespace>LidAwake</RootNamespace>
    <!-- Screen capture and the H.264 encoder call DXGI, Direct3D 11 and Media Foundation through their COM vtables. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- WMI, for the ACPI thermal zones (the heat limit's second temperature source). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared phone page, next to the exe. -->
    <None Include="..\..\web\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\sky-*.jpg" Link="sky\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The app icon at the two sizes the phone page asks for (apple-touch 180, icon 512). -->
    <None Update="icon-512.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon-180.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
